{
  "manifest_version": 3,
  "name": "Loggd",
  "version": "1.4.0",
  "description": "Open a movie on Letterboxd, IMDb, TMDB, Rotten Tomatoes, or Metacritic, and see where to stream it.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
